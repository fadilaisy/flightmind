# Copy to infra/deploy/.env (up.sh does this for you). .env is ignored by git; never commit it.

# Public host name. Leave empty and up.sh uses <public-ip-with-dashes>.sslip.io.
FLIGHTMIND_HOST=

# Database password. Empty: up.sh generates one. Use letters and digits only (it goes into a URL).
POSTGRES_PASSWORD=

# Optional. Without ANTHROPIC_API_KEY /api/ask answers are canned; without GEMINI_API_KEY no embeddings.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides
#FLIGHTMIND_LLM_MODEL=claude-haiku-5-5
#FLIGHTMIND_DEFAULT_RECORDING=
#FLIGHTMIND_ASK_PER_MINUTE=5
#FLIGHTMIND_ASK_PER_DAY=300
#FLIGHTMIND_MAX_UPLOAD_MB=2048
