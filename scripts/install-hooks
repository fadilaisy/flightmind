#!/usr/bin/env bash
# One-time setup per clone: check the Kiro trailer on every commit.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

git config core.hooksPath .githooks
echo "git config core.hooksPath .githooks     (commit-msg refuses a commit without a Kiro: trailer)"
git config commit.template .gitmessage
echo "git config commit.template .gitmessage  (new commit messages start from the template)"
echo "Done. Trailer forms are listed in docs/kiro/README.md."
