{
  "enabled": true,
  "name": "Pipeline property tests",
  "description": "When a pipeline Python file is saved, run the pipeline tests with the active Python.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["services/pipeline/**/*.py"]
  },
  "then": {
    "type": "runCommand",
    "command": "python -m pytest services/pipeline -q"
  }
}
