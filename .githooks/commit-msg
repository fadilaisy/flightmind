#!/bin/sh
# Refuses a commit whose message has no valid "Kiro:" trailer line (SCRUM-70).
# Install once with scripts/install-hooks. Rules: docs/kiro/README.md.
msg_file="$1"

# Merge commits and fixup/squash commits are allowed through.
merge_head=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null || echo .git/MERGE_HEAD)
[ -f "$merge_head" ] && exit 0
first=$(grep -v '^#' "$msg_file" | head -n 1 | tr -d '\r')
case "$first" in
  fixup!*|squash!*|Merge\ *) exit 0 ;;
esac

if grep -v '^#' "$msg_file" | tr -d '\r' \
  | grep -Eq '^Kiro: (spec [a-z0-9-]+/[A-Za-z0-9.,_-]+|vibe|hook|none)$'; then
  exit 0
fi

cat >&2 <<'EOF'
Commit refused: the message needs a line that says where the change came from.
Add one of these four lines (usually the last line):

  Kiro: spec <spec>/<task>   Kiro implemented a spec task, e.g. Kiro: spec ingest/2.3
  Kiro: vibe                 Kiro wrote or edited it in a chat session, not a spec task
  Kiro: hook                 a hook in .kiro/hooks produced it
  Kiro: none                 a person typed it without Kiro

Rule: whoever typed the diff decides the trailer. Details: docs/kiro/README.md
EOF
exit 1
