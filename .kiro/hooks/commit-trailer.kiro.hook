{
  "enabled": true,
  "name": "Check commit trailer",
  "description": "When an agent turn ends, check that any commit made in the turn has a valid Kiro: trailer.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If you made a git commit in this turn, run `git log -1 --format=%B` and check that it ends with exactly one valid `Kiro:` trailer as docs/kiro/README.md describes: `Kiro: spec <spec>/<task>`, `Kiro: vibe`, `Kiro: hook` or `Kiro: none`. If it does not, tell the user in one line which trailer it should have (who typed the diff decides) and do not amend a commit that is already pushed. If you made no commit, or the trailer is valid, say nothing and change nothing."
  }
}
