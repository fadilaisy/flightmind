{
  "enabled": true,
  "name": "Regenerate contract types",
  "description": "When contracts/openapi.yaml is saved, regenerate contracts/types.ts (pinned to openapi-typescript 7).",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["contracts/openapi.yaml"]
  },
  "then": {
    "type": "runCommand",
    "command": "npx --yes openapi-typescript@7 contracts/openapi.yaml -o contracts/types.ts"
  }
}
